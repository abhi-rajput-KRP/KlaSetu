{
  "expo": {
    "name": "KlaSetu",
    "slug": "klasetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#F3E6D3",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klasetu.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3E6D3"
      },
      "package": "com.klasetu.app"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "KlaSetu requires access to your photos to upload craft images.",
          "cameraPermission": "KlaSetu requires access to your camera to take craft photos."
        }
      ]
    ]
  }
}
